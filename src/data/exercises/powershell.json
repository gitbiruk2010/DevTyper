    "level": "advanced",
    "focus": "advanced_function",
    "text": "function Remove-OldFiles {\n    [CmdletBinding(SupportsShouldProcess)]\n    param([string]$Path, [int]$Days = 30)\n\n    Get-ChildItem $Path -File |\n        Where-Object LastWriteTime -lt (Get-Date).AddDays(-$Days) |\n        Remove-Item -WhatIf:$WhatIfPreference\n}",
    "source_language": "powershell",
    "difficulty_score": 9
