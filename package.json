{
  "name": "dev-typer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": {
    "name": "Biruk.B",
    "url": "https://github.com/gitbiruk2010",
    "email": "103274295+gitbiruk2010@users.noreply.github.com"
  },
  "description": "DevTyper - A developer typing tutor for mastering code typing speed",
  "license": "MIT",
  "homepage": "https://github.com/gitbiruk2010/DevTyper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitbiruk2010/DevTyper.git"
  },
  "bugs": {
    "url": "https://github.com/gitbiruk2010/DevTyper/issues"
  },
  "keywords": [
    "typing",
    "typing-tutor",
    "developer",
    "electron",
    "react",
    "code-typing"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "tsx scripts/build-electron.ts",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.devtyper.app",
    "productName": "DevTyper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icons/icon.ico",
      "build/icons/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "verifyUpdateCodeSignature": false,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevTyper",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "license": "LICENSE"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "build/icons/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icons/icon.png",
      "maintainer": "Biruk.B <103274295+gitbiruk2010@users.noreply.github.com>",
      "synopsis": "Developer typing tutor",
      "artifactName": "${productName}-${version}-linux.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5",
    "@electron/get": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
